{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit(/**)",
      "Write(/**)",
      "NotebookEdit",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Edit(//home/itec/emanuele/Datasets/**)",
      "Edit(//home/itec/emanuele/Models/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m tools.agent_hooks.session_start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m tools.agent_hooks.guard_large_read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
